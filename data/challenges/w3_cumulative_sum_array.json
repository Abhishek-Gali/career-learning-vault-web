{
  "id": "w3_cumulative_sum_array",
  "title": "W3Schools: Cumulative Sum Array",
  "platform": "W3Schools",
  "difficulty": "Hard",
  "category": "Prefix Sums",
  "description": "Given an array of integers `nums`, return a running cumulative sum array where `out[i] = sum(nums[0]..nums[i])`.",
  "constraints": "0 <= len(nums) <= 10^5\n\u2022 Time: O(N) | Space: O(N)",
  "function_name": "cumulative_sum",
  "starter_code": "def cumulative_sum(nums: list[int]) -> list[int]:\n    pass\n",
  "visible_tests": [
    {
      "input": {
        "nums": [
          1,
          2,
          3,
          4
        ]
      },
      "expected": [
        1,
        3,
        6,
        10
      ]
    },
    {
      "input": {
        "nums": [
          1,
          1,
          1,
          1,
          1
        ]
      },
      "expected": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  ],
  "hidden_tests": [
    {
      "input": {
        "nums": []
      },
      "expected": []
    },
    {
      "input": {
        "nums": [
          3,
          1,
          2,
          10,
          1
        ]
      },
      "expected": [
        3,
        4,
        6,
        16,
        17
      ]
    }
  ],
  "solution": "def cumulative_sum(nums: list[int]) -> list[int]:\n    res = []\n    curr = 0\n    for x in nums:\n        curr += x\n        res.append(curr)\n    return res\n",
  "explanation": "Iterative accumulation produces prefix sums in O(N) time."
}