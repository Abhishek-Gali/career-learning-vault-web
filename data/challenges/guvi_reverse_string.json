  "title": "GUVI: Reverse a String",
  "platform": "GUVI - CodeKata",
  "difficulty": "Easy",
  "category": "Strings",
  "description": "Given a string `s`, return the reversed string.",
  "constraints": "0 <= len(s) <= 10^5\n\u2022 Time: O(N) | Space: O(N)",
  "function_name": "reverse_string",
  "starter_code": "def reverse_string(s: str) -> str:\n    pass\n",
  "visible_tests": [
