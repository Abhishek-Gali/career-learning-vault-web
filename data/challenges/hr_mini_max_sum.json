{
  "id": "hr_mini_max_sum",
  "title": "HackerRank: Mini-Max Sum",
  "platform": "HackerRank",
  "difficulty": "Easy",
  "category": "Warmup & Math",
  "description": "Given five positive integers `arr`, find the minimum and maximum values that can be calculated by summing exactly four of the five integers. Return a list `[min_sum, max_sum]`.",
  "constraints": "len(arr) == 5\n\u2022 Time: O(1) | Space: O(1)",
  "function_name": "mini_max_sum",
  "starter_code": "def mini_max_sum(arr: list[int]) -> list[int]:\n    pass\n",
  "visible_tests": [
    {
      "input": {
        "arr": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "expected": [
        10,
        14
      ]
    },
    {
      "input": {
