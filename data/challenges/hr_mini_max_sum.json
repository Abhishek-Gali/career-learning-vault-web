        20
      ]
    },
    {
      "input": {
        "arr": [
          1,
          3,
          5,
          7,
          9
        ]
      },
      "expected": [
        16,
        24
      ]
    }
  ],
  "solution": "def mini_max_sum(arr: list[int]) -> list[int]:\n    total = sum(arr)\n    return [total - max(arr), total - min(arr)]\n",
  "explanation": "Subtracting max element gives min 4-sum; subtracting min gives max 4-sum in O(1) time."
}