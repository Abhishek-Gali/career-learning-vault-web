  "category": "Linked Lists & Sorting",
  "description": "Given a list of sorted integer lists `lists`, flatten all elements into a single sorted list.",
  "constraints": "0 <= len(lists) <= 1000\n\u2022 Time: O(N log N) | Space: O(N)",
  "function_name": "flatten_list",
  "starter_code": "def flatten_list(lists: list[list[int]]) -> list[int]:\n    pass\n",
  "visible_tests": [
