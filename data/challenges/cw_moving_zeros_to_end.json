{
  "id": "cw_moving_zeros_to_end",
  "title": "Codewars 5kyu: Moving Zeros To The End",
  "platform": "Codewars",
  "difficulty": "Hard",
  "category": "Two Pointers & Arrays",
  "description": "Write an algorithm that takes an array and moves all of the zeros to the end, preserving the order of the other elements.",
  "constraints": "0 <= len(lst) <= 10^5\n\u2022 Time: O(N) | Space: O(N)",
  "function_name": "move_zeros",
  "starter_code": "def move_zeros(lst: list[int]) -> list[int]:\n    pass\n",
  "visible_tests": [
    {
      "input": {
        "lst": [
          1,
          2,
          0,
          1,
          0,
          1,
          0,
          3,
          0,
          1
        ]
      },
      "expected": [
        1,
        2,
        1,
        1,
        3,
        1,
        0,
        0,
        0,
        0
      ]
    },
    {
      "input": {
        "lst": [
          0,
          0
        ]
      },
      "expected": [
        0,
        0
      ]
    }
  ],
  "hidden_tests": [
    {
      "input": {
        "lst": []
      },
      "expected": []
    },
    {
      "input": {
        "lst": [
          1,
          2,
          3
        ]
      },
      "expected": [
        1,
        2,
        3
      ]
    }
  ],
  "solution": "def move_zeros(lst: list[int]) -> list[int]:\n    non_zeros = [x for x in lst if x != 0]\n    zeros = [0] * (len(lst) - len(non_zeros))\n    return non_zeros + zeros\n",
  "explanation": "Separates non-zeros and zeroes in O(N) time."
}